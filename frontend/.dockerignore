.env
.env.*
**/.env
**/.env.*
.npmrc
**/.npmrc

# Documentation, old patches and stitch design screens
*.patch
**/*.patch
*.zip
**/*.zip
*.bundle
**/*.bundle
*.md
**/*.md

# Logs and OS metadata
.git
**/.git
.npm
**/.npm
*.log
**/*.log
.DS_Store
Thumbs.db
