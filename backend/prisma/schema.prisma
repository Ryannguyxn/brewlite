// BrewLite - Prisma database schema
// Source of truth for database structure: database/schema.dbml
// Proposed SCRUM-76 Phase 2 Payment extension (review kit; not applied to repository).
// PostgreSQL CHECK constraints and partial unique indexes
// are maintained through SQL migrations.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id       String  @id @default(uuid()) @db.Uuid
  code     String  @unique @db.VarChar(50)
  name     String  @db.VarChar(100)
  isActive Boolean @default(true) @map("is_active")

  products Product[]

  @@map("categories")
}

model Product {
  id           String            @id @default(uuid()) @db.Uuid
  categoryId   String            @map("category_id") @db.Uuid
  name         String            @db.VarChar(255)
  description  String?           @db.Text
  basePriceVnd BigInt            @map("base_price_vnd")
  imageUrl     String            @map("image_url") @db.VarChar(2048)
  stock        Int
  isNew        Boolean           @default(false) @map("is_new")
  isBestseller Boolean           @default(false) @map("is_bestseller")
  rating       Decimal?          @db.Decimal(2, 1)
  sizePolicy   ProductSizePolicy @default(STANDARD) @map("size_policy")
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  orderItems      OrderItem[]
  productToppings ProductTopping[]

  @@index([categoryId], map: "ix_products_category_id")
  @@map("products")
}

model Topping {
  id                String             @id @default(uuid()) @db.Uuid
  code              String             @unique @db.VarChar(50)
  name              String             @db.VarChar(255)
  priceVnd          BigInt             @map("price_vnd")
  isAvailable       Boolean            @default(true) @map("is_available")
  orderItemToppings OrderItemTopping[]
  productToppings   ProductTopping[]

  @@map("toppings")
}

model ProductTopping {
  productId String @map("product_id") @db.Uuid
  toppingId String @map("topping_id") @db.Uuid

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  topping Topping @relation(fields: [toppingId], references: [id], onDelete: Cascade)

  @@id([productId, toppingId])
  @@index([toppingId], map: "ix_product_toppings_topping_id")
  @@map("product_toppings")
}

enum OrderStatus {
  PENDING
  PAYMENT_FAILED
  PAID
  PREPARING
  READY
  COMPLETED
  CANCELLED

  @@map("order_status")
}

enum DrinkSize {
  S
  M
  L
  ONE_SIZE

  @@map("drink_size")
}

enum ProductSizePolicy {
  STANDARD
  ONE_SIZE

  @@map("product_size_policy")
}

enum CouponType {
  PERCENT
  FIXED

  @@map("coupon_type")
}

enum RedemptionStatus {
  HELD
  CONSUMED
  RELEASED

  @@map("redemption_status")
}

enum PaymentMethod {
  CARD
  WALLET

  @@map("payment_method")
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  @@map("payment_status")
}

enum PaymentProvider {
  MOCK
  VNPAY
  ZERO_AMOUNT
  @@map("payment_provider")
}
enum PaymentReconciliationState {
  NONE
  SCHEDULED
  RESOLVED
  REQUIRES_REVIEW
  @@map("payment_reconciliation_state")
}
enum PaymentGatewaySource {
  IPN
  QUERYDR
  @@map("payment_gateway_source")
}
enum PaymentGatewayOutcome {
  UNKNOWN
  SUCCESS
  FAILED
  @@map("payment_gateway_outcome")
}
enum PaymentGatewayDisposition {
  OBSERVED
  FINALIZED
  DUPLICATE
  CONFLICT
  FINANCIAL_EXCEPTION
  @@map("payment_gateway_disposition")
}



model User {
  id                String             @id @default(uuid()) @db.Uuid
  email             String             @unique @db.VarChar(255)
  passwordHash      String             @map("password_hash") @db.VarChar(255)
  fullName          String?            @map("full_name") @db.VarChar(255)
  loyaltyPoints     Int                @default(0) @map("loyalty_points")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  couponRedemptions CouponRedemption[]
  orders            Order[]
  payments Payment[]

  @@map("users")
}

model Coupon {
  id               String             @id @default(uuid()) @db.Uuid
  code             String             @unique @db.VarChar(30)
  type             CouponType
  value            Int
  minSubtotalVnd   BigInt             @default(0) @map("min_subtotal_vnd")
  maxDiscountVnd   BigInt?            @map("max_discount_vnd")
  startsAt         DateTime           @map("starts_at") @db.Timestamptz(6)
  expiresAt        DateTime           @map("expires_at") @db.Timestamptz(6)
  usageLimit       Int                @map("usage_limit")
  perUserLimit     Int                @default(1) @map("per_user_limit")
  activeUsageCount Int                @default(0) @map("active_usage_count")
  redemptions      CouponRedemption[]

  orders Order[]

  @@map("coupons")
}

model Order {
  id                 String            @id @default(uuid()) @db.Uuid
  userId             String            @map("user_id") @db.Uuid
  couponId           String?           @map("coupon_id") @db.Uuid
  couponCodeSnapshot String?           @map("coupon_code_snapshot") @db.VarChar(30)
  status             OrderStatus       @default(PENDING)
  subtotalVnd        BigInt            @map("subtotal_vnd")
  discountVnd        BigInt            @default(0) @map("discount_vnd")
  totalVnd           BigInt            @map("total_vnd")
  pointsEarned       Int               @default(0) @map("points_earned")
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)
  expiresAt          DateTime          @map("expires_at") @db.Timestamptz(6)
  paidAt             DateTime?         @map("paid_at") @db.Timestamptz(6)
  cancelledAt        DateTime?         @map("cancelled_at") @db.Timestamptz(6)
  couponRedemption   CouponRedemption?

  user   User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  coupon Coupon?     @relation(fields: [couponId], references: [id], onDelete: Restrict)
  items  OrderItem[]
  payments Payment[]

  @@index([userId], map: "ix_orders_user_id")
  @@index([userId, createdAt], map: "ix_orders_user_created")
  @@map("orders")
}

model OrderItem {
  id                   String    @id @default(uuid()) @db.Uuid
  orderId              String    @map("order_id") @db.Uuid
  productId            String    @map("product_id") @db.Uuid
  productNameSnapshot  String    @map("product_name_snapshot") @db.VarChar(255)
  size                 DrinkSize
  sizePercentSnapshot  Int       @map("size_percent_snapshot")
  basePriceSnapshotVnd BigInt    @map("base_price_snapshot_vnd")
  unitPriceVnd         BigInt    @map("unit_price_vnd")
  quantity             Int
  lineTotalVnd         BigInt    @map("line_total_vnd")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  order    Order              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product  Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  toppings OrderItemTopping[]

  @@index([orderId], map: "ix_order_items_order_id")
  @@index([productId], map: "ix_order_items_product_id")
  @@map("order_items")
}

model OrderItemTopping {
  id                      String @id @default(uuid()) @db.Uuid
  orderItemId             String @map("order_item_id") @db.Uuid
  toppingId               String @map("topping_id") @db.Uuid
  toppingCodeSnapshot     String @map("topping_code_snapshot") @db.VarChar(50)
  toppingNameSnapshot     String @map("topping_name_snapshot") @db.VarChar(255)
  toppingPriceSnapshotVnd BigInt @map("topping_price_snapshot_vnd")

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  topping   Topping   @relation(fields: [toppingId], references: [id], onDelete: Restrict)

  @@unique([orderItemId, toppingId], map: "uq_order_item_topping")
  @@unique([orderItemId, toppingCodeSnapshot], map: "uq_order_item_topping_code")
  @@map("order_item_toppings")
}

model CouponRedemption {
  id       String @id @default(uuid()) @db.Uuid
  couponId String @map("coupon_id") @db.Uuid
  orderId  String @unique(map: "uq_coupon_redemptions_order_id") @map("order_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid

  status     RedemptionStatus @default(HELD)
  heldAt     DateTime         @default(now()) @map("held_at") @db.Timestamptz(6)
  consumedAt DateTime?        @map("consumed_at") @db.Timestamptz(6)
  releasedAt DateTime?        @map("released_at") @db.Timestamptz(6)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([couponId, status], map: "ix_coupon_redemptions_coupon_status")
  @@index([userId, couponId, status], map: "ix_coupon_redemptions_user_coupon_status")
  @@map("coupon_redemptions")
}

model Payment {
  id                   String @id @default(uuid()) @db.Uuid
  orderId              String @map("order_id") @db.Uuid
  userId               String @map("user_id") @db.Uuid
  idempotencyKey       String @map("idempotency_key") @db.VarChar(64)
  requestHash          String @map("request_hash") @db.VarChar(128)
  amountVnd            BigInt @map("amount_vnd")
  provider             PaymentProvider
  method               PaymentMethod?
  status               PaymentStatus
  mockReference        String? @map("mock_reference") @db.VarChar(255)
  methodLast4          String? @map("method_last4") @db.VarChar(4)
  responseSnapshot     Json? @map("response_snapshot") @db.JsonB
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  // CK-R01: DB-clock touch must be explicit on mutations, no Prisma @updatedAt.
  updatedAt            DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  vnpTxnRef            String? @unique(map: "uq_payments_vnp_txn_ref") @map("vnp_txn_ref") @db.VarChar(100)
  vnpTmnCode           String? @map("vnp_tmn_code") @db.Text
  vnpCreateDate        String? @map("vnp_create_date") @db.VarChar(14)
  gatewayExpiresAt     DateTime? @map("gateway_expires_at") @db.Timestamptz(6)
  initiationSnapshot   Json? @map("initiation_snapshot") @db.JsonB
  finalOutcomeSnapshot Json? @map("final_outcome_snapshot") @db.JsonB
  verifiedPaidAt       DateTime? @map("verified_paid_at") @db.Timestamptz(6)
  verifiedAt           DateTime? @map("verified_at") @db.Timestamptz(6)
  finalizedAt          DateTime? @map("finalized_at") @db.Timestamptz(6)
  reconciliationState PaymentReconciliationState @default(NONE) @map("reconciliation_state")
  nextQueryAt          DateTime? @map("next_query_at") @db.Timestamptz(6)
  lastQueryAt          DateTime? @map("last_query_at") @db.Timestamptz(6)
  queryAttempts        Int @default(0) @map("query_attempts")
  reconcileUntil       DateTime? @map("reconcile_until") @db.Timestamptz(6)
  claimToken           String? @map("claim_token") @db.Uuid
  leaseExpiresAt       DateTime? @map("lease_expires_at") @db.Timestamptz(6)
  lastQueryRequestId   String? @map("last_query_request_id") @db.VarChar(64)
  lastQueryError       String? @map("last_query_error") @db.Text
  reviewReason         String? @map("review_reason") @db.Text
  hasFinancialException Boolean @default(false) @map("has_financial_exception")
  order                Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user                 User @relation(fields: [userId], references: [id], onDelete: Restrict)
  gatewayEvents        PaymentGatewayEvent[]
  @@unique([userId, idempotencyKey], map: "uq_payments_user_idempotency")
  @@index([orderId], map: "ix_payments_order_id")
  @@index([reconciliationState, nextQueryAt, id], map: "ix_payments_reconcile_due")
  @@index([reconciliationState, reconcileUntil, id], map: "ix_payments_reconcile_horizon")
  @@map("payments")
}

model PaymentGatewayEvent {
  id                  String @id @default(uuid()) @db.Uuid
  paymentId           String @map("payment_id") @db.Uuid
  source              PaymentGatewaySource
  eventIdentity       String @map("event_identity") @db.VarChar(64)
  queryRequestId      String? @map("query_request_id") @db.VarChar(64)
  responseCode        String? @map("response_code") @db.Text
  transactionStatus   String? @map("transaction_status") @db.Text
  gatewayTransactionNo String? @map("gateway_transaction_no") @db.Text
  amountVnd           BigInt? @map("amount_vnd")
  gatewayPaidAt       DateTime? @map("gateway_paid_at") @db.Timestamptz(6)
  outcome             PaymentGatewayOutcome
  disposition         PaymentGatewayDisposition
  exceptionReason     String? @map("exception_reason") @db.Text
  receivedAt          DateTime @map("received_at") @db.Timestamptz(6)
  verifiedAt          DateTime @map("verified_at") @db.Timestamptz(6)
  evidence            Json @db.JsonB
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  payment             Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  @@unique([paymentId, source, eventIdentity], map: "uq_payment_gateway_events_identity")
  @@index([paymentId, receivedAt, id], map: "ix_payment_gateway_events_history")
  @@map("payment_gateway_events")
}
