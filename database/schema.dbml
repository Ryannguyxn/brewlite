// BrewLite ERD - paste this file into https://dbdiagram.io
// Names in snake_case correspond to the uppercase entity names in BrewLite_ERD.docx.
// Cart is stored in frontend Zustand/localStorage, so it has no database table.
// The following PostgreSQL partial unique indexes need to be added in migrations:
// CREATE UNIQUE INDEX uq_orders_one_active_per_user ON orders(user_id)
//   WHERE status IN ('PENDING', 'PAYMENT_FAILED');
// CREATE UNIQUE INDEX uq_payments_one_success_per_order ON payments(order_id)
//   WHERE status = 'SUCCESS';

Project BrewLite {
  database_type: 'PostgreSQL'
  Note: 'MVP coffee ordering with mock payments, coupons, loyalty, and product-level stock.'
}

Enum order_status {
  PENDING
  PAYMENT_FAILED
  PAID
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

Enum drink_size {
  S
  M
  L
}

Enum payment_method {
  WALLET
  CARD
}

Enum payment_status {
  SUCCESS
  FAILED
}

Enum coupon_type {
  PERCENT
  FIXED
}

Enum redemption_status {
  HELD
  CONSUMED
  RELEASED
}

Enum inventory_movement_type {
  RESERVE
  RELEASE
}

Enum inventory_movement_reason {
  ORDER
  CANCEL
  EXPIRED
}

Table users {
  id uuid [pk, not null]
  email varchar(255) [not null, unique, note: 'Trimmed and lowercased before storage']
  password_hash varchar(255) [not null, note: 'bcrypt hash only']
  full_name varchar(255)
  loyalty_points int [not null, default: 0, check: `loyalty_points >= 0`]
  created_at timestamptz [not null, default: `now()`]

  Note: '''
    CHECK CONSTRAINT REQUIRED

    ck_users_loyalty_points_nonnegative
    CHECK (loyalty_points >= 0)

    Implementation: PostgreSQL / Prisma migration
  '''
}

Table products {
  id uuid [pk, not null]
  name varchar(255) [not null]
  base_price_vnd bigint [not null, check: `base_price_vnd >= 0`]
  image_url varchar(2048) [not null]
  stock int [not null, check: `stock >= 0`, note: 'Available cups across all sizes']
  created_at timestamptz [not null, default: `now()`]

  Note: '''
    CHECK CONSTRAINTS REQUIRED

    1. ck_products_stock_nonnegative
       CHECK (stock >= 0)

    2. ck_products_base_price_nonnegative
       CHECK (base_price_vnd >= 0)

    Implementation: PostgreSQL / Prisma migration
  '''
}

Table toppings {
  id uuid [pk, not null]
  code varchar(50) [not null, unique]
  name varchar(255) [not null]
  price_vnd bigint [not null, check: `price_vnd >= 0`]

  Note: '''
    CHECK CONSTRAINT REQUIRED

    ck_toppings_price_nonnegative
    CHECK (price_vnd >= 0)

    Implementation: PostgreSQL / Prisma migration
  '''
}

Table coupons {
  id uuid [pk, not null]
  code varchar(30) [not null, unique, note: 'Normalized uppercase']
  type coupon_type [not null]
  value int [not null, check: `value > 0`]
  min_subtotal_vnd bigint [not null, default: 0, check: `min_subtotal_vnd >= 0`]
  max_discount_vnd bigint [note: 'Applies only to PERCENT coupons']
  starts_at timestamptz [not null]
  expires_at timestamptz [not null]
  usage_limit int [not null, check: `usage_limit > 0`]
  per_user_limit int [not null, default: 1, check: `per_user_limit > 0`]
  active_usage_count int [not null, default: 0, check: `active_usage_count >= 0`, note: 'HELD plus CONSUMED']

  checks {
    `expires_at > starts_at` [name: 'ck_coupon_time_window']

    `active_usage_count <= usage_limit` [name: 'ck_coupon_usage_limit']

    `type <> 'PERCENT' OR value <= 100` [name: 'ck_coupons_percent_range']

    `max_discount_vnd IS NULL OR max_discount_vnd >= 0` [name: 'ck_coupons_max_discount_nonnegative']
  }
}

Table orders {
  id uuid [pk, not null, note: 'Opaque public order ID']
  user_id uuid [not null]
  coupon_id uuid
  coupon_code_snapshot varchar(30)
  status order_status [not null, default: 'PENDING']
  subtotal_vnd bigint [not null]
  discount_vnd bigint [not null, default: 0]
  total_vnd bigint [not null]
  points_earned int [not null, default: 0, check: `points_earned >= 0`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  expires_at timestamptz [not null, note: '15 minutes after order creation']
  paid_at timestamptz
  cancelled_at timestamptz

  checks {
    `subtotal_vnd >= 0 AND discount_vnd >= 0 AND discount_vnd <= subtotal_vnd` [name: 'ck_order_discount']
    `total_vnd = subtotal_vnd - discount_vnd` [name: 'ck_order_total']
  }

  indexes {
    user_id [name: 'ix_orders_user_id']
    (user_id, created_at) [name: 'ix_orders_user_created']
  }

  Note: '''
    PARTIAL UNIQUE INDEX REQUIRED

    Name: uq_orders_one_active_per_user
    Column: user_id
    Condition: status IN ('PENDING', 'PAYMENT_FAILED')

    Rule:
    Each Customer can have at most one Order
    in PENDING or PAYMENT_FAILED status.

    Enforcement:
    PostgreSQL partial unique index.
    Implement through Prisma migration
    or supported Prisma index configuration.


    ORDER BUSINESS RULES

    R1. ORDER ITEMS
    Every Order must contain at least
    one OrderItem.

    Validate during Order creation.


    R2. ORDER EXPIRATION
    expires_at = created_at + 15 minutes.

    Payment retries do not extend expires_at.

    New payment attempts after expiration
    must be rejected even if the expiration
    scheduler has not cancelled the Order.


    R3. ORDER FINANCIAL SNAPSHOT
    Order subtotal, discount, total,
    coupon snapshot and item snapshots
    must not change after Order creation.

    Enforcement:
    Backend business logic and transactions.
  '''
}

Table order_items {
  id uuid [pk, not null]
  order_id uuid [not null]
  product_id uuid [not null]
  product_name_snapshot varchar(255) [not null]
  size drink_size [not null]
  size_percent_snapshot int [not null, note: 'S=100, M=120, L=140']
  base_price_snapshot_vnd bigint [not null]
  unit_price_vnd bigint [not null, note: 'Size-adjusted price plus topping snapshots']
  quantity int [not null, check: `quantity >= 1 AND quantity <= 10`]
  line_total_vnd bigint [not null]
  created_at timestamptz [not null, default: `now()`]

  checks {
    `base_price_snapshot_vnd >= 0 AND unit_price_vnd >= 0` [name: 'ck_order_item_prices']
    `line_total_vnd = unit_price_vnd * quantity` [name: 'ck_order_item_total']
  }

  indexes {
    order_id [name: 'ix_order_items_order_id']
    product_id [name: 'ix_order_items_product_id']
  }
}

Table order_item_toppings {
  id uuid [pk, not null]
  order_item_id uuid [not null]
  topping_id uuid [not null, note: 'Required FK; preserve referenced toppings using ON DELETE RESTRICT']
  topping_code_snapshot varchar(50) [not null]
  topping_name_snapshot varchar(255) [not null]
  topping_price_snapshot_vnd bigint [not null, check: `topping_price_snapshot_vnd >= 0`]

  indexes {
    (order_item_id, topping_id) [unique, name: 'uq_order_item_topping']
    (order_item_id, topping_code_snapshot) [unique, name: 'uq_order_item_topping_code']
  }

  Note: 'Maximum three distinct toppings per order item; enforce in the order service.'
}

Table payments {
  id uuid [pk, not null, note: 'Transaction ID']
  order_id uuid [not null]
  user_id uuid [not null]
  idempotency_key varchar(64) [not null]
  request_hash varchar(128) [not null]
  amount_vnd bigint [not null, check: `amount_vnd >= 0`]
  method payment_method [not null]
  status payment_status [not null]
  mock_reference varchar(255)
  method_last4 varchar(4) [note: 'Masked display value only']
  response_snapshot jsonb [not null, note: 'Safe response for idempotent replay']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, idempotency_key) [unique, name: 'uq_payments_user_idempotency']
    order_id [name: 'ix_payments_order_id']
  }

  Note: '''
    PARTIAL UNIQUE INDEX REQUIRED

    Name: uq_payments_one_success_per_order
    Column: order_id
    Condition: status = 'SUCCESS'

    Rule:
    Each Order can have at most one
    successful Payment.
    Multiple FAILED Payments are allowed.

    Enforcement:
    PostgreSQL partial unique index.


    CROSS-TABLE CONSISTENCY RULES

    R1. PAYMENT OWNERSHIP

    payments.user_id must equal orders.user_id
    for the referenced Order.

    Backend must derive user_id from the
    authenticated user and verify ownership.

    Optional DB enforcement:
    Composite FK (order_id, user_id)
    references orders (id, user_id).


    R2. PAYMENT AMOUNT CONSISTENCY

    payments.amount_vnd must equal
    orders.total_vnd.

    Backend must read the stored Order total.
    Never trust amount_vnd from client input.

    The Order financial snapshot must remain
    unchanged after Order creation.


    R3. ATOMIC PAYMENT PROCESSING

    Payment SUCCESS:
    - Create one Payment SUCCESS.
    - Update Order status to PAID.
    - Consume held CouponRedemption if applicable.
    - Award loyalty points exactly once.
    - Keep reserved inventory unchanged.

    Payment FAILED:
    - Create one Payment FAILED.
    - Update Order status to PAYMENT_FAILED.
    - Keep reserved inventory unchanged.
    - Keep CouponRedemption HELD.
    - Do not award loyalty points.

    All database changes must be atomic.

    Enforcement:
    PostgreSQL transaction via Prisma.
  '''
}

Table coupon_redemptions {
  id uuid [pk, not null]
  coupon_id uuid [not null]
  order_id uuid [not null, unique, note: 'At most one coupon per order']
  user_id uuid [not null]
  status redemption_status [not null]
  held_at timestamptz [not null]
  consumed_at timestamptz
  released_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (coupon_id, user_id, status) [name: 'ix_coupon_user_status']
  }

  Note: '''
    CROSS-TABLE CONSISTENCY RULES

    R1. REDEMPTION OWNERSHIP

    coupon_redemptions.user_id must equal
    orders.user_id for the referenced order_id.

    coupon_redemptions.coupon_id must equal
    orders.coupon_id for the referenced order_id.

    Order without coupon must not have
    a CouponRedemption record.

    Enforcement:
    Backend transaction with ownership
    and coupon consistency validation.

    R2. REDEMPTION STATUS CONSISTENCY

    Order PENDING or PAYMENT_FAILED:
    Redemption must remain HELD.

    Order PAID, PREPARING, READY or COMPLETED:
    Redemption must be CONSUMED.

    Order CANCELLED:
    Redemption must be RELEASED.

    Payment retry must not create
    another CouponRedemption.

    R3. COUPON QUOTA CONSISTENCY

    On Order creation:
    - Create one HELD Redemption.
    - Increment active_usage_count once.
    - Check global and per-user limits.

    On Payment SUCCESS:
    - Change HELD to CONSUMED.
    - Do not increment usage count again.

    On Payment FAILED:
    - Keep Redemption HELD.
    - Do not modify usage count.

    On Order CANCELLED:
    - Change HELD to RELEASED.
    - Decrement active_usage_count once.

    All operations must be atomic.

    Enforcement:
    PostgreSQL transaction via Prisma,
    conditional updates and database constraints.
  '''
}

// Optional audit table from FR-INV-004 (SHOULD).
Table inventory_movements {
  id uuid [pk, not null]
  product_id uuid [not null]
  order_id uuid [not null]
  type inventory_movement_type [not null]
  reason inventory_movement_reason [not null]
  quantity_delta int [not null, check: `quantity_delta <> 0`]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (order_id, product_id, type) [unique, name: 'uq_inventory_order_product_type']
  }

  checks {
    `(
      (type = 'RESERVE' AND quantity_delta < 0)
      OR
      (type = 'RELEASE' AND quantity_delta > 0)
    )` [name: 'ck_inventory_delta_direction']

    `(
      (type = 'RESERVE' AND reason = 'ORDER')
      OR
      (type = 'RELEASE' AND reason IN ('CANCEL', 'EXPIRED'))
    )` [name: 'ck_inventory_type_reason']
  }

  Note: '''
    CROSS-TABLE INVENTORY CONSISTENCY

    R1. AGGREGATE QUANTITY BY PRODUCT

    For each Order, group all OrderItems
    by product_id.

    Required quantity for each Product
    equals SUM(order_items.quantity).

    Different sizes and toppings of the same
    Product share the same product stock.


    R2. ATOMIC STOCK RESERVATION

    On Order creation:
    - Aggregate required quantity by Product.
    - Check available stock for each Product.
    - Atomically decrement stock if sufficient.
    - Reject Order if any Product lacks stock.
    - Never allow stock below zero.

    All stock updates, Order creation and
    related records must be in one transaction.


    R3. STOCK RESERVATION LIFECYCLE

    Stock is reserved once when Order
    is created in PENDING status.

    Payment FAILED:
    - Keep reserved stock unchanged.

    Payment retry:
    - Do not reserve stock again.

    Payment SUCCESS:
    - Do not decrement stock again.

    PAID, PREPARING, READY, COMPLETED:
    - No additional stock changes.


    R4. RELEASE STOCK EXACTLY ONCE

    When Order transitions from
    PENDING or PAYMENT_FAILED to CANCELLED:

    - Restore previously reserved quantities.
    - Create RELEASE inventory movements.
    - Perform release exactly once.

    Repeated cancellation or expiration
    must not restore stock again.


    R5. INVENTORY MOVEMENT CONSISTENCY

    Each InventoryMovement must refer
    to the correct Order and Product.

    For each Order and Product:
    - RESERVE quantity_delta equals
      negative SUM(OrderItem.quantity).
    - RELEASE quantity_delta equals
      positive SUM(OrderItem.quantity).

    At most one RESERVE and one RELEASE
    per Order and Product.

    Release is allowed only when the Order
    successfully transitions to CANCELLED.


    R6. INVENTORY TRANSACTION CONSISTENCY

    Product stock changes and
    InventoryMovement records must
    be committed in the same transaction.

    If any operation fails:
    Rollback all changes.

    InventoryMovement records must not
    be edited or deleted through public APIs.

    Enforcement:
    PostgreSQL transactions via Prisma,
    conditional updates and database constraints.
  '''
}

Ref: users.id < orders.user_id [delete: restrict]
Ref: users.id < payments.user_id [delete: restrict]
Ref: users.id < coupon_redemptions.user_id [delete: restrict]

Ref: products.id < order_items.product_id [delete: restrict]
Ref: products.id < inventory_movements.product_id [delete: restrict]

Ref: toppings.id < order_item_toppings.topping_id [delete: restrict]

Ref: coupons.id ?< orders.coupon_id [delete: restrict]
Ref: coupons.id < coupon_redemptions.coupon_id [delete: restrict]

Ref: orders.id < order_items.order_id [delete: restrict]
Ref: orders.id < payments.order_id [delete: restrict]
Ref: orders.id - coupon_redemptions.order_id [delete: restrict]
Ref: orders.id < inventory_movements.order_id [delete: restrict]

Ref: order_items.id < order_item_toppings.order_item_id [delete: restrict]

Note data_integrity_policy {
'''
BREWLITE DATA INTEGRITY POLICY

1. NULLABILITY
Required business fields must be NOT NULL.
Optional or lifecycle-dependent fields
may be NULL.

2. DELETE POLICY
Preserve all historical and financial data.
Do not cascade-delete Order, OrderItem,
Payment, CouponRedemption or
InventoryMovement records.

3. FOREIGN KEYS
Use RESTRICT or equivalent safe
delete behavior for historical relations.

4. DATA RETENTION
Products, Toppings and Coupons referenced
by historical Orders must be preserved.

5. IMPLEMENTATION
Enforce constraints in PostgreSQL
through Prisma schema and migrations.
'''
}
