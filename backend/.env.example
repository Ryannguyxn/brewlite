# Keep your existing local database URL when adding JWT configuration.
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5433/brewlite_db?schema=public"
PORT=3001
# Generate a random value locally; never commit the populated .env file.
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Optional: separate migrated PostgreSQL database used by npm run test:integration.
AUTH_TEST_DATABASE_URL=
