# BrewLite Frontend Environment Variables

# 1. URL backend dùng trực tiếp từ trình duyệt (Client-side browser fetch)
# Nếu không cung cấp, client-side mặc định gọi qua Next.js Rewrite Proxy: /api/backend/*
NEXT_PUBLIC_API_URL=http://localhost:3001

# 2. URL backend dùng bên trong container (Container-side rewrite proxy & SSR)
# Khi chạy trong Docker Compose: dùng tên service, ví dụ: http://backend:3001
# Khi backend chạy trực tiếp trên host Windows: dùng http://host.docker.internal:3001
BACKEND_INTERNAL_URL=http://backend:3001
