// PROPOSED v0.2.2 L1-L3 CK-R01-R03 UPDATED - ARCHITECTURE DIRECTION APPROVED; PHYSICAL SCHEMA NOT APPROVED - NOT A MIGRATION
// 11 existing implemented tables + 1 NEW payment_gateway_events.
// Existing scalar definitions from local Prisma; CHECKs from existing migration files.
// L1 APPROVED ARCHITECTURE DIRECTION only; this DBML still a DESIGN CANDIDATE.
// L2 PRINCIPLE AGREED in review; independent Leader approval evidence is pending. v0.3 REVIEWED is superseded for L1-L3 decision interpretation.
// L2: Missing trustworthy gateway paid timestamp => do not mark Order PAID; keep verified
// gateway observation while Grace runs; after Grace CANCEL/release and flag financial exception.
// Timestamp verification with VNPay Sandbox remains VERIFY. L3 timeout/lease/rate-limit VERIFY.
// Claim/lease duration is configured at service runtime, not hard-coded at DBML/schema level.
// CK-R01: payments.updated_at is a new persisted timestamp; Order.updated_at already exists.
// API-03 order-level lastUpdatedAt = max(orders.updated_at, all payments.updated_at); each verified
// new gateway event must touch parent Payment.updated_at atomically. All writes use DB clock;
// no implicit Prisma @updatedAt for Payment or DB trigger is assumed. Legacy Mock backfill
// payments.updated_at from payments.created_at (fallback; not historical true update time).
// CK-R02: resolution, requiresReview, canRetry, hasFinancialException, PaymentSummary are
// order-wide READ PROJECTIONS; not extra columns or constraints. Query ALL attempts/events.
// CK-R03: Requirements v3.1 APPROVED per new Leader decision reported by requester;
// API Contract v4.0 Review 2 Revised still CANDIDATE; exact DTO/enum mapping to VERIFY.
// QueryDR E, E+10... example is not a guaranteed schedule; no catch-up burst after downtime.
// PARTIAL UNIQUE indexes must be created/retained as SQL migration predicates, not unconditional DBML unique:
// RETAIN uq_orders_one_active_per_user ON orders(user_id) WHERE status IN ('PENDING','PAYMENT_FAILED')
// RETAIN uq_payments_one_success_per_order ON payments(order_id) WHERE status = 'SUCCESS'
// ADD uq_payments_one_pending_vnpay_per_order ON payments(order_id) WHERE provider='VNPAY' AND status='PENDING'
// WARNING: The three partial UNIQUE indexes above are NOT declared as unconditional DBML indexes.
// This diagram does NOT create their predicates when exported/generated to SQL.
// After approved migration, verify in pg_index + pg_get_expr(indpred,indrelid): all 3 present, unique, valid, correct table/columns/predicate.
// Before Phase 2 migration, only the first 2 should already exist. See companion Markdown section 7.1.
// The supplied official DBML mentions optional inventory_movements, absent from actual Prisma/migrations: NOT added here.
Project BrewLite_Phase2_Proposed {
  database_type: 'PostgreSQL'
  Note: 'v0.2.2 CK-R01-R03 candidate. Requirements v3.1 Approved per newly reported Leader decision; API Contract v4.0 remains CANDIDATE. L1 architecture direction APPROVED; L2 principle AGREED; L3 Backend VERIFY. CK-R01 adds Payment.updated_at; CK-R02 projections derived from Order+all Payment/event evidence. Physical schema NOT approved; not a migration. Partial UNIQUE indexes require SQL.'
}

Enum order_status {
  PENDING
  PAYMENT_FAILED
  PAID
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

Enum drink_size {
  S
  M
  L
  ONE_SIZE
}

Enum product_size_policy {
  STANDARD
  ONE_SIZE
}

Enum coupon_type {
  PERCENT
  FIXED
}

Enum redemption_status {
  HELD
  CONSUMED
  RELEASED
}

Enum payment_method {
  CARD
  WALLET
}

Enum payment_status {
  PENDING
  SUCCESS
  FAILED
}

Enum payment_provider {
  MOCK
  VNPAY
  ZERO_AMOUNT
}

Enum payment_reconciliation_state {
  NONE
  SCHEDULED
  RESOLVED
  REQUIRES_REVIEW
}

Enum payment_gateway_source {
  IPN
  QUERYDR
}

Enum payment_gateway_outcome {
  UNKNOWN
  SUCCESS
  FAILED
}

Enum payment_gateway_disposition {
  OBSERVED
  FINALIZED
  DUPLICATE
  CONFLICT
  FINANCIAL_EXCEPTION
}

// EXISTING - UNCHANGED
Table categories {
  id uuid [pk, not null, note: 'UUID generated by Prisma/application; no new DB default']
  code varchar(50) [not null, unique]
  name varchar(100) [not null]
  is_active boolean [not null, default: true]

  Note: 'EXISTING - UNCHANGED. Context only; no Phase 2 migration changes to this table.'
}

// EXISTING - UNCHANGED
Table products {
  id uuid [pk, not null, note: 'UUID generated by Prisma/application; no new DB default']
  category_id uuid [not null]
  name varchar(255) [not null]
  description text
  base_price_vnd bigint [not null]
  image_url varchar(2048) [not null]
  stock int [not null]
  is_new boolean [not null, default: false]
  is_bestseller boolean [not null, default: false]
  rating decimal(2, 1)
  size_policy product_size_policy [not null, default: 'STANDARD']
  created_at timestamptz(6) [not null, default: `now()`]
  updated_at timestamptz(6) [not null, default: `now()`]

  indexes {
    category_id [name: 'ix_products_category_id']
  }

  checks {
    `stock >= 0` [name: 'ck_products_stock_nonnegative']
    `base_price_vnd >= 0` [name: 'ck_products_base_price_nonnegative']
    `rating BETWEEN 0 AND 5` [name: 'ck_products_rating_range']
  }

  Note: 'EXISTING - UNCHANGED. Context only; no Phase 2 migration changes to this table.'
}

// EXISTING - UNCHANGED
Table toppings {
  id uuid [pk, not null, note: 'UUID generated by Prisma/application; no new DB default']
  code varchar(50) [not null, unique]
  name varchar(255) [not null]
  price_vnd bigint [not null]
  is_available boolean [not null, default: true]

  checks {
    `price_vnd >= 0` [name: 'ck_toppings_price_nonnegative']
  }

  Note: 'EXISTING - UNCHANGED. Context only; no Phase 2 migration changes to this table.'
}

// EXISTING - UNCHANGED
Table product_toppings {
  product_id uuid [not null]
  topping_id uuid [not null]

  indexes {
    (product_id, topping_id) [pk]
    topping_id [name: 'ix_product_toppings_topping_id']
  }

  Note: 'EXISTING - UNCHANGED. Context only; no Phase 2 migration changes to this table.'
}

// EXISTING - UNCHANGED
Table users {
  id uuid [pk, not null, note: 'UUID generated by Prisma/application; no new DB default']
  email varchar(255) [not null, unique]
  password_hash varchar(255) [not null]
  full_name varchar(255)
  loyalty_points int [not null, default: 0]
  created_at timestamptz(6) [not null, default: `now()`]
  updated_at timestamptz(6) [not null, default: `now()`]

  checks {
    `loyalty_points >= 0` [name: 'ck_users_loyalty_points_nonnegative']
  }

  Note: 'EXISTING - UNCHANGED. Context only; no Phase 2 migration changes to this table.'
}

// EXISTING - UNCHANGED
Table coupons {
  id uuid [pk, not null, note: 'UUID generated by Prisma/application; no new DB default']
  code varchar(30) [not null, unique]
  type coupon_type [not null]
  value int [not null]
  min_subtotal_vnd bigint [not null, default: 0]
  max_discount_vnd bigint
  starts_at timestamptz(6) [not null]
  expires_at timestamptz(6) [not null]
  usage_limit int [not null]
  per_user_limit int [not null, default: 1]
  active_usage_count int [not null, default: 0]

  checks {
    `min_subtotal_vnd >= 0` [name: 'ck_coupons_min_subtotal_nonnegative']
    `max_discount_vnd IS NULL OR max_discount_vnd >= 0` [name: 'ck_coupons_max_discount_nonnegative']
    `active_usage_count >= 0` [name: 'ck_coupons_active_usage_count_nonnegative']
    `expires_at > starts_at` [name: 'ck_coupons_valid_date_range']
    `type <> 'PERCENT' OR value BETWEEN 0 AND 100` [name: 'ck_coupons_percent_range']
    `value > 0` [name: 'ck_coupons_value_positive']
    `usage_limit >= 1` [name: 'ck_coupons_usage_limit_positive']
    `per_user_limit >= 1` [name: 'ck_coupons_per_user_limit_positive']
    `active_usage_count <= usage_limit` [name: 'ck_coupons_active_usage_within_limit']
  }

  Note: 'EXISTING - UNCHANGED. Context only; no Phase 2 migration changes to this table.'
}

// EXISTING - UNCHANGED
Table orders {
  id uuid [pk, not null, note: 'UUID generated by Prisma/application; no new DB default']
  user_id uuid [not null]
  coupon_id uuid
  coupon_code_snapshot varchar(30)
  status order_status [not null, default: 'PENDING']
  subtotal_vnd bigint [not null]
  discount_vnd bigint [not null, default: 0]
  total_vnd bigint [not null]
  points_earned int [not null, default: 0]
  created_at timestamptz(6) [not null, default: `now()`]
  updated_at timestamptz(6) [not null, default: `now()`]
  expires_at timestamptz(6) [not null]
  paid_at timestamptz(6)
  cancelled_at timestamptz(6)

  indexes {
    user_id [name: 'ix_orders_user_id']
    (user_id, created_at) [name: 'ix_orders_user_created']
  }

  checks {
    `subtotal_vnd >= 0` [name: 'ck_orders_subtotal_nonnegative']
    `discount_vnd >= 0` [name: 'ck_orders_discount_nonnegative']
    `total_vnd >= 0` [name: 'ck_orders_total_nonnegative']
    `points_earned >= 0` [name: 'ck_orders_points_earned_nonnegative']
    `discount_vnd <= subtotal_vnd` [name: 'ck_orders_discount_within_subtotal']
    `total_vnd = subtotal_vnd - discount_vnd` [name: 'ck_orders_total_calculation']
  }

  Note: 'EXISTING - UNCHANGED. Retain SQL partial UNIQUE uq_orders_one_active_per_user ON orders(user_id) WHERE status IN (PENDING, PAYMENT_FAILED). Not represented as unconditional DBML unique. Must verify predicate/validity on PostgreSQL; no GRACE state, expires_at unchanged.'
}

// EXISTING - UNCHANGED
Table order_items {
  id uuid [pk, not null, note: 'UUID generated by Prisma/application; no new DB default']
  order_id uuid [not null]
  product_id uuid [not null]
  product_name_snapshot varchar(255) [not null]
  size drink_size [not null]
  size_percent_snapshot int [not null]
  base_price_snapshot_vnd bigint [not null]
  unit_price_vnd bigint [not null]
  quantity int [not null]
  line_total_vnd bigint [not null]
  created_at timestamptz(6) [not null, default: `now()`]

  indexes {
    order_id [name: 'ix_order_items_order_id']
    product_id [name: 'ix_order_items_product_id']
  }

  checks {
    `quantity BETWEEN 1 AND 10` [name: 'ck_order_items_quantity_range']
    `base_price_snapshot_vnd >= 0` [name: 'ck_order_items_base_price_nonnegative']
    `unit_price_vnd >= 0` [name: 'ck_order_items_unit_price_nonnegative']
    `line_total_vnd >= 0` [name: 'ck_order_items_line_total_nonnegative']
    `line_total_vnd = unit_price_vnd * quantity` [name: 'ck_order_items_line_total_calculation']
    `(size = 'S' AND size_percent_snapshot = 100) OR (size = 'M' AND size_percent_snapshot = 120) OR (size = 'L' AND size_percent_snapshot = 140) OR (size = 'ONE_SIZE' AND size_percent_snapshot = 100)` [name: 'ck_order_items_size_percent']
  }

  Note: 'EXISTING - UNCHANGED. Context only; no Phase 2 migration changes to this table.'
}

