    order_id [unique, name: 'uq_coupon_redemptions_order_id']
  }

  Note: 'EXISTING - UNCHANGED. Context only; no Phase 2 migration changes to this table.'
}

// EXISTING - EXTEND
Table payments {
  id uuid [pk, not null, note: 'UUID generated by Prisma/application; no new DB default']
  order_id uuid [not null]
  user_id uuid [not null]
  idempotency_key varchar(64) [not null]
  request_hash varchar(128) [not null]
  amount_vnd bigint [not null]
  provider payment_provider [not null, note: 'NEW Phase 2']
  method payment_method [note: 'CHANGED nullable; conditional CHECK preserves Mock']
  status payment_status [not null]
  mock_reference varchar(255)
  method_last4 varchar(4)
  response_snapshot jsonb [note: 'CHANGED nullable; conditional CHECK preserves Mock']
  created_at timestamptz(6) [not null, default: `now()`]
  updated_at timestamptz(6) [not null, default: `now()`, note: 'NEW CK-R01; write transaction must touch with DB clock on Payment/reconcile/verified event changes; legacy Mock backfill from created_at; NO automatic Prisma @updatedAt assumption']
  vnp_txn_ref varchar(100) [note: 'NEW Phase 2']
  vnp_tmn_code text [note: 'NEW Phase 2']
  vnp_create_date varchar(14) [note: 'NEW Phase 2']
  gateway_expires_at timestamptz(6) [note: 'NEW Phase 2']
  initiation_snapshot jsonb [note: 'NEW Phase 2']
  final_outcome_snapshot jsonb [note: 'NEW Phase 2']
  verified_paid_at timestamptz(6) [note: 'NEW Phase 2']
  verified_at timestamptz(6) [note: 'NEW Phase 2']
  finalized_at timestamptz(6) [note: 'NEW Phase 2']
  reconciliation_state payment_reconciliation_state [not null, default: 'NONE', note: 'NEW Phase 2']
  next_query_at timestamptz(6) [note: 'NEW Phase 2']
  last_query_at timestamptz(6) [note: 'NEW Phase 2']
  query_attempts int [not null, default: 0, note: 'NEW Phase 2']
  reconcile_until timestamptz(6) [note: 'NEW Phase 2']
  claim_token uuid [note: 'NEW Phase 2']
  lease_expires_at timestamptz(6) [note: 'NEW Phase 2']
  last_query_request_id varchar(64) [note: 'NEW Phase 2']
  last_query_error text [note: 'NEW Phase 2']
  review_reason text [note: 'NEW Phase 2']
  has_financial_exception boolean [not null, default: false, note: 'NEW Phase 2']

  indexes {
    (user_id, idempotency_key) [unique, name: 'uq_payments_user_idempotency']
    order_id [name: 'ix_payments_order_id']
    (reconciliation_state, next_query_at, id) [name: 'ix_payments_reconcile_due']
    (reconciliation_state, reconcile_until, id) [name: 'ix_payments_reconcile_horizon']
    vnp_txn_ref [unique, name: 'uq_payments_vnp_txn_ref']
  }

  checks {
    `amount_vnd >= 0` [name: 'ck_payments_amount_nonnegative']
    `(((provider = 'MOCK' AND method IS NOT NULL AND status IN ('SUCCESS','FAILED') AND response_snapshot IS NOT NULL) OR (provider = 'ZERO_AMOUNT' AND method IS NULL AND amount_vnd = 0 AND status = 'SUCCESS' AND response_snapshot IS NOT NULL) OR (provider = 'VNPAY' AND method IS NULL AND amount_vnd > 0 AND response_snapshot IS NULL))) IS TRUE` [name: 'ck_payments_provider_shape']
    `(provider = 'MOCK' OR (mock_reference IS NULL AND method_last4 IS NULL)) IS TRUE` [name: 'ck_payments_nonmock_mask']
    `(((provider = 'VNPAY' AND vnp_txn_ref IS NOT NULL AND length(vnp_txn_ref) > 0 AND vnp_tmn_code IS NOT NULL AND length(vnp_tmn_code) > 0 AND vnp_create_date IS NOT NULL AND vnp_create_date ~ '^[0-9]{14}$' AND gateway_expires_at IS NOT NULL AND gateway_expires_at > created_at AND initiation_snapshot IS NOT NULL AND reconcile_until IS NOT NULL) OR (provider <> 'VNPAY' AND vnp_txn_ref IS NULL AND vnp_tmn_code IS NULL AND vnp_create_date IS NULL AND gateway_expires_at IS NULL AND initiation_snapshot IS NULL AND final_outcome_snapshot IS NULL AND verified_paid_at IS NULL AND verified_at IS NULL AND finalized_at IS NULL AND reconcile_until IS NULL))) IS TRUE` [name: 'ck_payments_gateway_shape']
    `(provider <> 'VNPAY' OR ((status = 'PENDING' AND final_outcome_snapshot IS NULL AND finalized_at IS NULL AND verified_at IS NULL AND verified_paid_at IS NULL) OR (status IN ('SUCCESS','FAILED') AND final_outcome_snapshot IS NOT NULL AND finalized_at IS NOT NULL AND verified_at IS NOT NULL))) IS TRUE` [name: 'ck_payments_vnp_terminal']
    `((response_snapshot IS NULL OR jsonb_typeof(response_snapshot) = 'object') AND (initiation_snapshot IS NULL OR jsonb_typeof(initiation_snapshot) = 'object') AND (final_outcome_snapshot IS NULL OR jsonb_typeof(final_outcome_snapshot) = 'object')) IS TRUE` [name: 'ck_payments_json_objects']
    `(query_attempts >= 0) IS TRUE` [name: 'ck_payments_query_attempts']
    `(((provider <> 'VNPAY' AND reconciliation_state = 'NONE' AND next_query_at IS NULL AND review_reason IS NULL) OR (provider = 'VNPAY' AND ((reconciliation_state = 'SCHEDULED' AND status = 'PENDING' AND next_query_at IS NOT NULL AND next_query_at <= reconcile_until AND review_reason IS NULL) OR (reconciliation_state = 'RESOLVED' AND status IN ('SUCCESS','FAILED') AND next_query_at IS NULL AND review_reason IS NULL) OR (reconciliation_state = 'REQUIRES_REVIEW' AND next_query_at IS NULL AND review_reason IS NOT NULL AND length(review_reason) > 0))))) IS TRUE` [name: 'ck_payments_reconcile_shape']
    `((claim_token IS NULL AND lease_expires_at IS NULL) OR (claim_token IS NOT NULL AND lease_expires_at IS NOT NULL AND reconciliation_state = 'SCHEDULED')) IS TRUE` [name: 'ck_payments_claim_pair']
    `((query_attempts = 0 AND last_query_at IS NULL AND last_query_request_id IS NULL AND last_query_error IS NULL) OR (provider = 'VNPAY' AND query_attempts > 0 AND last_query_at IS NOT NULL AND last_query_request_id IS NOT NULL)) IS TRUE` [name: 'ck_payments_query_history']
    `(NOT has_financial_exception OR (provider = 'VNPAY' AND reconciliation_state = 'REQUIRES_REVIEW')) IS TRUE` [name: 'ck_payments_financial_review']
    `(provider = 'VNPAY' OR (query_attempts = 0 AND next_query_at IS NULL AND last_query_at IS NULL AND last_query_request_id IS NULL AND last_query_error IS NULL AND claim_token IS NULL AND lease_expires_at IS NULL AND review_reason IS NULL AND has_financial_exception = false)) IS TRUE` [name: 'ck_payments_nonvnp_reconcile_clean']
  }

  Note: 'EXISTING - EXTEND; physical schema NOT YET APPROVED. Retain SQL partial UNIQUE uq_payments_one_success_per_order ON payments(order_id) WHERE status = SUCCESS; ADD separately approved SQL partial UNIQUE uq_payments_one_pending_vnpay_per_order ON payments(order_id) WHERE provider = VNPAY AND status = PENDING. Never use unconditional UNIQUE(order_id). Verify both in PostgreSQL pg_index after migration. Metadata/snapshots follow Markdown v0.2.2; provider has NO permanent default. CK-R01 updated_at is persisted and touched on change. CK-R02 order-level summary must aggregate all attempts, events and orders.updated_at; no additional stored resolution/retry flags.'
}

// NEW
Table payment_gateway_events {
  id uuid [pk, not null, note: 'NEW Phase 2; UUID generated by Prisma/application; no new DB default']
  payment_id uuid [not null, note: 'NEW Phase 2']
  source payment_gateway_source [not null, note: 'NEW Phase 2']
  event_identity varchar(64) [not null, note: 'NEW Phase 2']
  query_request_id varchar(64) [note: 'NEW Phase 2']
  response_code text [note: 'NEW Phase 2']
  transaction_status text [note: 'NEW Phase 2']
  gateway_transaction_no text [note: 'NEW Phase 2']
  amount_vnd bigint [note: 'NEW Phase 2']
  gateway_paid_at timestamptz(6) [note: 'NEW Phase 2']
  outcome payment_gateway_outcome [not null, note: 'NEW Phase 2']
  disposition payment_gateway_disposition [not null, note: 'NEW Phase 2']
  exception_reason text [note: 'NEW Phase 2']
  received_at timestamptz(6) [not null, note: 'NEW Phase 2']
  verified_at timestamptz(6) [not null, note: 'NEW Phase 2']
  evidence jsonb [not null, note: 'NEW Phase 2']
  created_at timestamptz(6) [not null, default: `now()`, note: 'NEW Phase 2']

  indexes {
    (payment_id, source, event_identity) [unique, name: 'uq_payment_gateway_events_identity']
    (payment_id, received_at, id) [name: 'ix_payment_gateway_events_history']
  }

  checks {
    `(event_identity ~ '^[0-9a-f]{64}$') IS TRUE` [name: 'ck_gateway_events_identity']
    `((source = 'IPN' AND query_request_id IS NULL AND amount_vnd IS NOT NULL) OR (source = 'QUERYDR' AND query_request_id IS NOT NULL)) IS TRUE` [name: 'ck_gateway_events_source']
    `(amount_vnd IS NULL OR amount_vnd >= 0) IS TRUE` [name: 'ck_gateway_events_amount']
    `(outcome = 'UNKNOWN' OR (amount_vnd IS NOT NULL AND response_code IS NOT NULL AND transaction_status IS NOT NULL)) IS TRUE` [name: 'ck_gateway_events_terminal_evidence']
    `((disposition IN ('CONFLICT','FINANCIAL_EXCEPTION') AND exception_reason IS NOT NULL AND length(exception_reason) > 0) OR (disposition NOT IN ('CONFLICT','FINANCIAL_EXCEPTION') AND exception_reason IS NULL)) IS TRUE` [name: 'ck_gateway_events_exception']
    `(jsonb_typeof(evidence) = 'object') IS TRUE` [name: 'ck_gateway_events_evidence']
    `((disposition = 'FINALIZED' AND outcome IN ('SUCCESS','FAILED')) OR (disposition = 'FINANCIAL_EXCEPTION' AND outcome = 'SUCCESS') OR (disposition = 'CONFLICT' AND outcome IN ('SUCCESS','FAILED')) OR disposition IN ('OBSERVED','DUPLICATE')) IS TRUE` [name: 'ck_gateway_events_disposition_outcome']
  }

  Note: 'NEW. Verified IPN/QueryDR only. OBSERVED can contain verified financial SUCCESS while Payment remains PENDING if paid timestamp is not trustworthy; before E and during Grace do not infer paid time from callback arrival. At/after G, Order CANCELLED/release per BR-03; retain evidence/manual-review flag, never resurrect. Finalization may reference prior immutable OBSERVED event; no invalid-signature event, no cascade delete. Timestamp provenance remains Backend/Sandbox VERIFY.'
}

Ref: products.category_id > categories.id [delete: restrict, update: cascade]
Ref: product_toppings.product_id > products.id [delete: cascade, update: cascade]
Ref: product_toppings.topping_id > toppings.id [delete: cascade, update: cascade]
Ref: orders.user_id > users.id [delete: restrict, update: cascade]
Ref: orders.coupon_id > coupons.id [delete: restrict, update: cascade]
Ref: order_items.order_id > orders.id [delete: restrict, update: cascade]
Ref: order_items.product_id > products.id [delete: restrict, update: cascade]
Ref: order_item_toppings.order_item_id > order_items.id [delete: restrict, update: cascade]
Ref: order_item_toppings.topping_id > toppings.id [delete: restrict, update: cascade]
Ref: coupon_redemptions.coupon_id > coupons.id [delete: restrict, update: cascade]
Ref: coupon_redemptions.order_id > orders.id [delete: restrict, update: cascade]
Ref: coupon_redemptions.user_id > users.id [delete: restrict, update: cascade]
Ref: payments.order_id > orders.id [delete: restrict, update: cascade]
Ref: payments.user_id > users.id [delete: restrict, update: cascade]
Ref: payment_gateway_events.payment_id > payments.id [delete: restrict, update: cascade]
